# Copia a .env y rellena. NUNCA commitees .env con valores reales (está en .gitignore).
# Un único módulo de configuración lee estas variables; nada de credenciales hardcodeadas.

# Ejemplos (borra/añade según tu stack):
# DATABASE_URL=postgres://user:pass@localhost:5432/<PROJECT>
# API_BASE_URL=http://localhost:8080
# AUTH_SECRET=change-me
